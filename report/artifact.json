  "sources": [
    {
      "id": "benchmark_metrics",
      "label": "EgoDemo benchmark metric snapshot",
      "path": "queries/benchmark_metrics.sql",
      "query": {
        "engine": "DuckDB 1.x",
        "sql": "-- DuckDB query over the reviewed Python benchmark outputs.\nSELECT\n  method,\n  segment,\n  value,\n  samples,\n  gt_hands,\n  pred_hands,\n  matched_hands,\n  hand_recall,\n  hand_precision,\n  hand_f1,\n  e2e_pck_005,\n  e2e_pck_010,\n  matched_pck_005,\n  matched_pck_010,\n  mean_pixel_error,\n  mean_nme,\n  handedness_accuracy,\n  pa_mpjpe_mm,\n  mean_runtime_ms,\n  median_runtime_ms,\n  p95_runtime_ms,\n  mean_landmark_runtime_ms\nFROM read_csv_auto(\n  'hand_pose_benchmark/results/metrics/metrics_all_segments.csv',\n  header = true\n);\n",
        "language": "sql",
        "executed_at": "2026-08-27T16:30:00Z",
        "description": "Reads the reviewed evaluator outputs for overall, task, and camera segments.",
        "tables_used": [
          "hand_pose_benchmark/results/metrics/metrics_all_segments.csv"
        ],
        "filters": [
          "Four downloaded EgoDemo tasks, both head cameras",
          "Every 10th Standard-video frame plus each final frame",
          "Hands with an explicit bad reason, fewer than 12 visible joints, or bbox diagonal below 16 px are excluded"
        ],
        "metric_definitions": [
          "End-to-end PCK@t = correctly localized reference joints / all evaluable reference joints; an undetected hand contributes zero correct joints.",
          "Matched PCK@t uses only matched hands; t is normalized by the reference hand bounding-box diagonal.",
          "A reference/prediction pair is matched when mean normalized joint error is below 0.50; pairing is minimum-cost and independent of handedness.",
          "Reported runtime starts after video frame decoding. RTMPose end-to-end runtime adds MediaPipe detection and RTMPose landmark stages."
        ]
      }
    },
    {
      "id": "reference_quality",
      "label": "EgoDemo reference quality snapshot",
      "path": "queries/reference_quality.sql",
      "query": {
        "engine": "DuckDB 1.x",
        "sql": "-- DuckDB query over the quality summary emitted by src/evaluate.py.\nSELECT\n  sampled_camera_frames,\n  reference_hands,\n  explicitly_bad_hands,\n  evaluable_hands,\n  evaluable_share,\n  median_visible_joints,\n  minimum_visible_joints,\n  match_nme_threshold,\n  pck_thresholds\nFROM read_json_auto(\n  'hand_pose_benchmark/results/metrics/reference_quality.json'\n);\n",
        "language": "sql",
        "executed_at": "2026-08-27T16:30:00Z",
        "description": "Reads the reference eligibility and explicit bad-frame summary.",
        "tables_used": [
          "hand_pose_benchmark/results/metrics/reference_quality.json"
        ],
        "filters": [
          "Same deterministic stride-10 camera-frame sample as the benchmark"
        ],
        "metric_definitions": [
          "Evaluable share = evaluable reference hands / all sampled reference hands.",
          "Visible joints are projected into the Standard video using the same-UUID Raw undistorted camera intrinsics and per-frame camera pose."
        ]
      }
    },
    {
      "id": "project_inventory",
      "label": "Official repository due-diligence snapshot",
      "path": "queries/project_inventory.sql",
      "query": {
        "engine": "DuckDB 1.x",
        "sql": "-- Curated 2026-08-27 snapshot of official repository metadata and due diligence.\nSELECT *\nFROM (\n  VALUES\n    ('MediaPipe Hand Landmarker', 'Google AI Edge', 36700, 'Apache-2.0',\n     'run_recommended', '2D landmarks, handedness, hand-relative 3D',\n     'https://github.com/google-ai-edge/mediapipe'),\n    ('MMPose / RTMPose-Hand5', 'OpenMMLab', 7900, 'Apache-2.0',\n     'run_recommended', '2D hand landmarks; requires a hand box',\n     'https://github.com/open-mmlab/mmpose'),\n    ('Sapiens2 Pose 0.4B', 'Meta', 919, 'Sapiens2 custom license',\n     'run_rejected_for_ego_full_frame', '308 whole-body keypoints; not a hand detector',\n     'https://github.com/facebookresearch/sapiens2'),\n    ('WiLoR', 'Imperial College London / SJTU', 650, 'CC BY-NC-ND + MANO',\n     'not_run_license_asset_required', 'End-to-end 3D hand mesh and localization',\n     'https://github.com/rolpotamias/WiLoR'),\n    ('HaWoR', 'SJTU / Imperial College London', 337, 'CC BY-NC-ND + MANO',\n     'not_run_heavy_license_asset_required', 'World-space egocentric hand motion',\n     'https://github.com/ThunderVVV/HaWoR'),\n    ('Hand Tracking Toolkit', 'Meta', 74, 'Apache-2.0 + data/model licenses',\n     'evaluation_utility_only', 'Egocentric metrics, data loading and visualization',\n     'https://github.com/facebookresearch/hand_tracking_toolkit')\n) AS projects(project, organization, github_stars, license, status, task_fit, official_url);\n",
        "language": "sql",
        "executed_at": "2026-08-27T16:30:00Z",
        "description": "Curated official-repository metadata checked on 2026-08-27.",
        "tables_used": [
          "github.com/google-ai-edge/mediapipe",
          "github.com/open-mmlab/mmpose",
          "github.com/facebookresearch/sapiens2",
          "github.com/rolpotamias/WiLoR",
          "github.com/ThunderVVV/HaWoR",
          "github.com/facebookresearch/hand_tracking_toolkit"
        ],
        "filters": [
          "Official repositories only",
          "Projects relevant to hand coordinates, egocentric reconstruction, or evaluation"
        ],
        "metric_definitions": [
          "GitHub stars are point-in-time counts displayed by the official repositories on 2026-08-27."
        ]
      }
    }
  ]
